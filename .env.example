# Link Vault Environment Configuration (Example)
# Copy this file to .env and replace placeholders with your actual settings.

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/linkvault?retryWrites=true&w=majority
PORT=3000
BASE_URL=http://localhost:3000
NODE_ENV=development
COOKIE_SECRET=change-this-to-a-secure-random-secret-string-at-least-32-chars
